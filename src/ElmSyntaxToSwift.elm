    var filterMappedSoFar: [b] = []
    while case let .List_Cons(head, tail) = remainingList {
        remainingList = tail
        if case let .Maybe_Just(headValue) = elementToMaybe(head) {
            filterMappedSoFar.append(headValue)
        }
    }
    return Array_toList(filterMappedSoFar)
}

