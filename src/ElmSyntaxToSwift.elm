public static func List_map5<a, b, c, d, e, combined>(
    _ combine: @escaping (a) -> (b) -> (c) -> (d) -> (e) -> combined,
) -> (List_List<a>) -> (List_List<b>) -> (List_List<c>) -> (List_List<d>) -> (List_List<e>) ->
    List_List<combined>
{
    { aList in
