    case .none: .List_Empty
    case let .some(regex):
        Array_toList(
            string.matches(of: regex).enumerated()
                .map({ (matchIndex0Based, match: Regex.Match) in
                    toRegexMatch(
                        match,
                        matchIndex1Based: 1 + matchIndex0Based,
                        in: string
