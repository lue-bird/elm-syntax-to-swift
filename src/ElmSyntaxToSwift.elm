printSwiftReturn : SwiftExpression -> Print
printSwiftReturn swiftResultExpression =
    let
        swiftResultExpressionPrint : Print
        swiftResultExpressionPrint =
            printSwiftExpressionNotParenthesized
                swiftResultExpression
    in
    Print.linebreakIndented
        |> Print.followedBy (Print.exactly "return")
        |> Print.followedBy
