        SwiftExpressionVariant _ ->
            False

        SwiftExpressionNegateOperation _ ->
            False

        SwiftExpressionRecordAccess _ ->
            False

        SwiftExpressionTuple _ ->
            False

        SwiftExpressionIfElse _ ->
            True

