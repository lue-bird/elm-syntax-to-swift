listFilledMapAndStringJoinWith : String -> (a -> String) -> a -> List a -> String
listFilledMapAndStringJoinWith separator elementChange head tail =
    List.foldl
        (\element leftSoFar ->
            leftSoFar ++ separator ++ (element |> elementChange) ++ ""
        )
        (head |> elementChange)
        tail


swiftTypeContainedVariables : SwiftType -> FastSet.Set String
swiftTypeContainedVariables swiftType =
    -- IGNORE TCO
    case swiftType of
        SwiftTypeVariable variable ->
            FastSet.singleton variable

        SwiftTypeTuple parts ->
            (parts.part0 |> swiftTypeContainedVariables)
                |> FastSet.union
                    (parts.part1 |> swiftTypeContainedVariables)
                |> FastSet.union
                    (parts.part2Up
                        |> listMapToFastSetsAndUnify
                            swiftTypeContainedVariables
                    )

        SwiftTypeRecord fields ->
            fields
                |> FastDict.values
                |> listMapToFastSetsAndUnify
                    swiftTypeContainedVariables

        SwiftTypeConstruct typeConstruct ->
            typeConstruct.arguments
                |> listMapToFastSetsAndUnify swiftTypeContainedVariables

        SwiftTypeFunction typeFunction ->
            FastSet.union
                (typeFunction.input
                    |> listMapToFastSetsAndUnify swiftTypeContainedVariables
                )
                (typeFunction.output |> swiftTypeContainedVariables)


{-| Does it contain type variables
-}
swiftTypeIsConcrete : SwiftType -> Bool
swiftTypeIsConcrete swiftType =
    -- IGNORE TCO
    case swiftType of
        SwiftTypeVariable _ ->
            True

        SwiftTypeTuple parts ->
            (parts.part0 |> swiftTypeIsConcrete)
                && (parts.part1 |> swiftTypeIsConcrete)
                && (parts.part2Up
                        |> List.all swiftTypeIsConcrete
                   )

        SwiftTypeRecord fields ->
            fields
                |> fastDictAll
                    (\_ fieldValue ->
                        fieldValue |> swiftTypeIsConcrete
                    )

        SwiftTypeConstruct typeConstruct ->
            typeConstruct.arguments
                |> List.all swiftTypeIsConcrete

        SwiftTypeFunction typeFunction ->
            (typeFunction.input
                |> List.all swiftTypeIsConcrete
            )
                && (typeFunction.output |> swiftTypeIsConcrete)


