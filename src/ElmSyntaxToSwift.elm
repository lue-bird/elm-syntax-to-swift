    return arrayMutable
}
@Sendable public static func Array_set<a>(
    _ indexAsDouble: Double,
    _ newElement: a,
    _ array: [a]
) -> [a] {
    let index: Int = Int(indexAsDouble)
    if (index >= 0) && (index < array.count) {
        var arrayMutable: [a] = array
        arrayMutable[index] = newElement
        return arrayMutable
    } else {
        return []
    }
}
