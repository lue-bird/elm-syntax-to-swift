swiftPatternAsExpression : SwiftPattern -> SwiftExpression
swiftPatternAsExpression swiftPattern =
    -- IGNORE TCO
    case swiftPattern of
        SwiftPatternIgnore ->
            swiftExpressionUnit

        SwiftPatternBool bool ->
            if bool then
                swiftExpressionReferenceTrue

            else
                swiftExpressionReferenceFalse

        SwiftPatternInteger int ->
            -- NUMBER currently represented as Double
            SwiftExpressionDouble (int |> Basics.toFloat)

        SwiftPatternUnicodeScalar char ->
            SwiftExpressionUnicodeScalar char

        SwiftPatternStringLiteral string ->
            SwiftExpressionStringLiteral string

        SwiftPatternVariable name ->
            SwiftExpressionReference
                { moduleOrigin = Nothing
                , name = name
                }

        SwiftPatternTuple parts ->
            SwiftExpressionTuple
                { part0 = parts.part0 |> swiftPatternAsExpression
                , part1 = parts.part1 |> swiftPatternAsExpression
                , part2Up =
                    parts.part2Up
                        |> List.map swiftPatternAsExpression
                }

        SwiftPatternVariant variant ->
            case variant.values of
                [] ->
                    SwiftExpressionVariant
                        { originTypeName = variant.originTypeName
                        , name = variant.name
                        }

                value0 :: value1Up ->
                    SwiftExpressionCall
                        { called =
                            SwiftExpressionVariant
                                { originTypeName = variant.originTypeName
                                , name = variant.name
                                }
                        , arguments =
                            (value0 :: value1Up)
                                |> List.map
                                    (\value ->
                                        { label = value.label
                                        , value = value.value |> swiftPatternAsExpression
                                        }
                                    )
                        }

        SwiftPatternRecord fields ->
            SwiftExpressionRecord
                (fields
                    |> FastDict.map
                        (\_ value ->
                            value |> swiftPatternAsExpression
                        )
                )


