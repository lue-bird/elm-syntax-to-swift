{-| Print a [`SwiftExpression`](#SwiftExpression)
-}
printSwiftExpressionNotParenthesized : SwiftExpression -> Print
printSwiftExpressionNotParenthesized swiftExpression =
    -- IGNORE TCO
    case swiftExpression of
        SwiftExpressionCall call ->
            printSwiftExpressionCall call

        SwiftExpressionSelf ->
            printSwiftExpressionSelf

        SwiftExpressionReference reference ->
            Print.exactly
                (reference |> qualifiedReferenceToSwiftName)

        SwiftExpressionVariant reference ->
            Print.exactly
                (reference.originTypeName
                    ++ "."
                    ++ reference.name
                )

        SwiftExpressionIfElse ifElse ->
            printSwiftExpressionIfElse ifElse

        SwiftExpressionUnicodeScalar charValue ->
            printSwiftStringLiteral (charValue |> String.fromChar)

        SwiftExpressionDouble double ->
            Print.exactly (double |> doubleLiteral)

        SwiftExpressionStringLiteral string ->
            printSwiftStringLiteral string

        SwiftExpressionTuple parts ->
            printSwiftExpressionTuple parts

        SwiftExpressionLambda syntaxLambda ->
            printSwiftExpressionLambda syntaxLambda

        SwiftExpressionRecord fields ->
            printSwiftExpressionRecord fields

        SwiftExpressionArrayLiteral elements ->
            printSwiftExpressionArrayLiteral elements

        SwiftExpressionNegateOperation inNegation ->
            printExactlyMinus
                |> Print.followedBy
                    (Print.withIndentIncreasedBy 1
                        (printSwiftExpressionParenthesizedIfSpaceSeparated
                            inNegation
                        )
                    )

        SwiftExpressionRecordAccess syntaxRecordAccess ->
            printSwiftExpressionParenthesizedIfSpaceSeparated
                syntaxRecordAccess.record
                |> Print.followedBy
                    (Print.exactly
                        ("." ++ syntaxRecordAccess.field)
                    )

        SwiftExpressionSwitch switch ->
            printSwiftExpressionSwitch switch


